---
import headshot from "../assets/good_enough2.png";
import { Image } from "astro:assets";
import Typography from "./typography/Typography.astro";
import SocialBar from "./SocialBar.astro";
---

<div
  class="m-8 flex flex-col-reverse items-center gap-8 rounded-lg border p-6 md:flex-row"
>
  <div class="flex flex-col gap-4">
    <Image
      class="rounded-lg"
      height="400"
      src={headshot}
      alt="A headshot of Connor Wade"
    />
    <div class="w-full">
      <SocialBar />
    </div>
  </div>
  <div class="flex flex-col gap-4">
    <Typography as="h3" variant="title">Connor Wade</Typography>
    <Typography as="p" variant="body" size="lg">
      Connor is an experienced engineer who has built applications and websites.
      He has been a lead engineer and manager for the last 3 years of his
      career. He also has built education and cultural resources and initiatives
      within companies. When not coding, Connor enjoys making music, lifting
      heavy weights, and writing.
    </Typography>
  </div>
</div>
